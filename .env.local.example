# =====================================================
# Dzawata Trophy - Environment Variables
# =====================================================
# Salin file ini menjadi `.env.local` lalu isi nilai di bawah.
# Nilai didapat dari Supabase Dashboard > Project Settings > API
# =====================================================

# URL project Supabase Anda (contoh: https://abcdxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon / Public key (aman ditaruh di frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL utama website (untuk SEO Open Graph). Contoh: https://dzawatatrophy.com
# Untuk development biarkan kosong (default ke http://localhost:3000)
NEXT_PUBLIC_SITE_URL=
